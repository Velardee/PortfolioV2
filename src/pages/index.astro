---
// Temporary until HomePage (Task 5).
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/nav/Nav.astro';
import Preloader from '../components/Preloader.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n';
const locale = 'es';
---

<BaseLayout locale={locale} title={t(locale, 'meta.home.title')} description={t(locale, 'meta.home.description')}>
  <Preloader locale={locale} />
  <Nav locale={locale} onHome />
  <main id="main"><h1>{t(locale, 'hero.h1.1')}</h1></main>
  <Footer locale={locale} />
</BaseLayout>
