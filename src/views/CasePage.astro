---
import { site } from '../config/site';
import { localizedPath, t, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/nav/Nav.astro';
import LineReveal from '../components/ui/LineReveal.astro';
import Reveal from '../components/ui/Reveal.astro';
import { slugOf, type ProjectEntry } from '../lib/content';

interface Props {
  locale: Locale;
  project: ProjectEntry;
  prev: ProjectEntry;
  next: ProjectEntry;
}
const { locale, project, prev, next } = Astro.props;
const p = project.data;
const home = localizedPath(locale, 'home');

const jsonLd = {
  '@type': 'CreativeWork',
  name: p.title,
  headline: p.headline,
  description: p.summary,
  dateCreated: p.year.split('–')[0],
  keywords: p.stack.join(', '),
  inLanguage: locale === 'es' ? 'es-MX' : 'en-US',
  author: { '@type': 'Person', name: site.name, url: site.url },
};

const sections = [
  ['01', t(locale, 'work.problem'), p.problem],
  ['02', t(locale, 'work.solution'), p.solution],
] as const;
---

<BaseLayout locale={locale} title={`${p.title} — ${t(locale, 'meta.case.suffix')}`} description={p.summary} jsonLd={jsonLd}>
  <Nav locale={locale} />
  <main id="main" class="mx-auto max-w-[1180px] px-4 md:px-9">
    <Reveal as="header" class="pt-14 pb-12 md:pt-20">
      <a href={`${home}#trabajo`} class="fade font-mono text-xs text-muted hover:text-bone">{t(locale, 'case.back')}</a>
      <p class="fade mt-8 font-mono text-xs text-signal">{p.client} · {p.year} · {p.role}</p>
      <p class="fade mt-3 text-sm font-semibold tracking-wide text-sub uppercase">{p.title}</p>
      <LineReveal tag="h1" class="mt-2 max-w-4xl font-display text-[clamp(2.5rem,6vw,4.75rem)] leading-[1] font-normal" lines={[{ text: p.headline }]} />
    </Reveal>

    <Reveal class="grid gap-10 border-t border-line/70 py-14 lg:grid-cols-[1fr_280px]">
      <div class="grid gap-12">
        {
          sections.map(([n, title, body]) => (
            <section class="fade">
              <h2 class="font-mono text-xs text-muted">// {n} — {title}</h2>
              <p class="mt-3 max-w-2xl text-lg leading-relaxed">{body}</p>
            </section>
          ))
        }
        <section class="fade">
          <h2 class="font-mono text-xs text-muted">// 03 — {t(locale, 'work.outcome')}</h2>
          {
            p.metrics.length > 0 && (
              <dl class="mt-4 grid grid-cols-2 gap-6 md:grid-cols-3">
                {p.metrics.map((m) => (
                  <div>
                    <dt class="font-display text-4xl">{m.value}</dt>
                    <dd class="font-mono text-xs text-muted">{m.label}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          <p class="mt-3 max-w-2xl text-lg leading-relaxed">{p.outcome}</p>
        </section>
      </div>
      <aside class="fade self-start rounded-xl border border-line/70 bg-surface p-5 lg:sticky lg:top-24">
        <h2 class="font-mono text-xs text-muted">{t(locale, 'case.stack')}</h2>
        <ul class="mt-3 grid gap-1.5 font-mono text-sm">{p.stack.map((s) => <li>{s}</li>)}</ul>
        <svg viewBox="0 0 200 120" class="mt-6 w-full text-line" aria-hidden="true">
          {p.stack.slice(0, 6).map((_, i) => (
            <rect x={10 + (i % 3) * 64} y={10 + Math.floor(i / 3) * 56} width="52" height="40" rx="6" fill="none" stroke="currentColor" />
          ))}
          <path d="M62 30h12M126 30h12M62 86h12M126 86h12M36 50v16" stroke="var(--signal)" fill="none" />
        </svg>
      </aside>
    </Reveal>

    <nav class="grid gap-4 border-t border-line/70 py-10 md:grid-cols-2" aria-label={t(locale, 'nav.work')}>
      <a href={localizedPath(locale, 'case', slugOf(prev))} class="group rounded-xl border border-line/70 p-5 hover:border-signal">
        <span class="font-mono text-xs text-muted">{t(locale, 'case.prev')}</span>
        <span class="mt-1 block text-lg font-bold">{prev.data.title}</span>
      </a>
      <a href={localizedPath(locale, 'case', slugOf(next))} class="group rounded-xl border border-line/70 p-5 text-right hover:border-signal">
        <span class="font-mono text-xs text-muted">{t(locale, 'case.next')}</span>
        <span class="mt-1 block text-lg font-bold">{next.data.title}</span>
      </a>
    </nav>
  </main>
  <Footer locale={locale} />
</BaseLayout>
