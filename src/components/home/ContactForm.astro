---
import { site } from '../../config/site';
import { localizedPath, t, type Locale, type UiKey } from '../../i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const types: ['hire' | 'project' | 'hello', UiKey][] = [
  ['hire', 'form.type.hire'],
  ['project', 'form.type.project'],
  ['hello', 'form.type.hello'],
];
const field = 'mt-1.5 w-full rounded-lg border border-line bg-ink px-4 py-3 text-bone placeholder:text-muted focus:border-signal focus:outline-none aria-invalid:border-[#ff8a65]';
---

<form
  name="contacto"
  method="POST"
  action={localizedPath(locale, 'thanks')}
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-contact-form
  data-locale={locale}
  data-msg-sending={t(locale, 'form.sending')}
  data-msg-network={`${t(locale, 'form.errNetwork')} ${site.email}`}
  data-msg-success={t(locale, 'form.success')}
  class="grid gap-5 rounded-2xl border border-line/70 bg-surface p-6 md:p-8"
>
  <input type="hidden" name="form-name" value="contacto" />
  <p hidden><label>Bot <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <fieldset>
    <legend class="font-mono text-xs text-muted">{t(locale, 'form.type.legend')}</legend>
    <div class="mt-2 flex flex-wrap gap-2">
      {
        types.map(([value, key], i) => (
          <label class="cursor-pointer rounded-full border border-line px-4 py-2 text-sm has-checked:border-signal has-checked:bg-signal has-checked:text-ink has-focus-visible:outline-2 has-focus-visible:outline-signal">
            <input type="radio" name="tipo" value={value} checked={i === 0} class="sr-only" />
            {t(locale, key)}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <label for="contact-name" class="text-sm">{t(locale, 'form.name')}</label>
      <input id="contact-name" name="name" required autocomplete="name" aria-describedby="err-name" class={field} />
      <p id="err-name" class="err mt-1 text-sm text-[#ff8a65]" aria-live="polite"></p>
    </div>
    <div>
      <label for="contact-email" class="text-sm">{t(locale, 'form.email')}</label>
      <input id="contact-email" name="email" type="email" required autocomplete="email" aria-describedby="err-email" class={field} />
      <p id="err-email" class="err mt-1 text-sm text-[#ff8a65]" aria-live="polite"></p>
    </div>
  </div>
  <div>
    <label for="contact-message" class="text-sm">{t(locale, 'form.message')}</label>
    <textarea id="contact-message" name="message" required rows="4" aria-describedby="err-message" class={field}></textarea>
    <p id="err-message" class="err mt-1 text-sm text-[#ff8a65]" aria-live="polite"></p>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="cursor-pointer rounded-lg bg-signal px-6 py-3.5 text-sm font-semibold text-ink disabled:opacity-60">
      {t(locale, 'form.submit')}
    </button>
    <p data-form-status role="status" class="font-mono text-xs text-sub"></p>
  </div>
</form>

<script>
  import { validateContact, type ContactType } from '../../lib/contact';
  import type { Locale } from '../../i18n';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    // JS shows our own messages; without JS the browser's required/type=email checks stay active.
    form.noValidate = true;
    const locale = form.dataset.locale as Locale;
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    // CTAs elsewhere preselect the type.
    document.querySelectorAll<HTMLElement>('[data-contact-type]').forEach((cta) => {
      cta.addEventListener('click', () => {
        const radio = form.querySelector<HTMLInputElement>(`input[name=tipo][value="${cta.dataset.contactType}"]`);
        if (radio) radio.checked = true;
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const input = {
        type: (data.get('tipo') ?? 'hello') as ContactType,
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        message: String(data.get('message') ?? ''),
      };
      const result = validateContact(input, locale);
      for (const f of ['name', 'email', 'message'] as const) {
        const el = form.querySelector<HTMLElement>(`#contact-${f}`)!;
        const msg = result.ok ? undefined : result.errors[f];
        el.setAttribute('aria-invalid', String(Boolean(msg)));
        form.querySelector<HTMLElement>(`#err-${f}`)!.textContent = msg ?? '';
      }
      if (!result.ok) {
        form.querySelector<HTMLElement>('[aria-invalid=true]')?.focus();
        return;
      }
      submit.disabled = true;
      status.textContent = form.dataset.msgSending ?? '';
      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = form.dataset.msgSuccess ?? '';
        status.className = 'font-mono text-xs text-ok';
      } catch {
        status.textContent = form.dataset.msgNetwork ?? '';
        status.className = 'font-mono text-xs text-[#ff8a65]';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
