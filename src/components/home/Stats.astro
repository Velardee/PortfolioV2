---
import { t, type Locale } from '../../i18n';
import Reveal from '../ui/Reveal.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const stats = [
  { count: 3, suffix: '+', label: t(locale, 'stats.years.label') },
  { count: 5, suffix: '', label: t(locale, 'stats.products.label') },
  { value: t(locale, 'stats.fullstack.value'), label: t(locale, 'stats.fullstack.label') },
  { value: t(locale, 'stats.reply.value'), label: t(locale, 'stats.reply.label') },
];
---

<Reveal as="div" data-stats class="grid grid-cols-2 border-y border-line/70 md:grid-cols-4">
  {
    stats.map((s, i) => (
      <div class:list={['fade px-1 py-6 md:px-6', i > 0 && 'md:border-l md:border-line/70']} style={`transition-delay:${i * 0.1}s`}>
        <p class="font-display text-4xl md:text-5xl">
          {'count' in s ? <span data-count={s.count} data-suffix={s.suffix}>{`${s.count}${s.suffix}`}</span> : s.value}
        </p>
        <p class="mt-1 font-mono text-xs text-muted">{s.label}</p>
      </div>
    ))
  }
</Reveal>

<script>
  const root = document.querySelector<HTMLElement>('[data-stats]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    root.addEventListener(
      'reveal:in',
      () => {
        root.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          const to = Number(el.dataset.count);
          const suffix = el.dataset.suffix ?? '';
          const t0 = performance.now();
          const step = (now: number) => {
            const p = Math.min(1, (now - t0) / 1400);
            el.textContent = `${Math.round(to * (1 - (1 - p) ** 3))}${p === 1 ? suffix : ''}`;
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        });
      },
      { once: true },
    );
  }
</script>
