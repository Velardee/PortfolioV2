---
import { site } from '../../config/site';
import { t, type Locale, type UiKey } from '../../i18n';
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';
import SectionHeader from '../ui/SectionHeader.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const offers: [UiKey, UiKey][] = [
  ['services.mvp.title', 'services.mvp.body'],
  ['services.rescue.title', 'services.rescue.body'],
  ['services.dash.title', 'services.dash.body'],
];
---

<Reveal as="section" id="servicios" aria-labelledby="servicios-title" class="scroll-mt-20 border-t border-line/70 py-20">
  <SectionHeader id="servicios-title" index="06" label={t(locale, 'services.label')} title={t(locale, 'services.title')} />
  <div class="grid gap-5 lg:grid-cols-2">
    <div class="fade flex flex-col rounded-2xl border border-line/70 bg-surface p-6 md:p-8">
      <h3 class="text-xl font-bold">{t(locale, 'services.teams.title')}</h3>
      <p class="mt-3 flex-1 leading-relaxed text-sub">{t(locale, 'services.teams.body')}</p>
      <div class="mt-6"><Button href={site.cvPath[locale]} variant="secondary">{t(locale, 'services.teams.cta')} ↓</Button></div>
    </div>
    <div class="fade flex flex-col rounded-2xl border border-line/70 bg-surface p-6 md:p-8" style="transition-delay:.12s">
      <h3 class="text-xl font-bold">{t(locale, 'services.projects.title')}</h3>
      <ul class="mt-3 flex-1 space-y-3">
        {
          offers.map(([title, body]) => (
            <li class="text-sub">
              <strong class="font-semibold text-bone">{t(locale, title)}:</strong> {t(locale, body)}
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <Button href="#contacto" data-contact-type="project">{t(locale, 'services.projects.cta')} →</Button>
        <p class="font-mono text-[11px] text-muted">{t(locale, 'services.note')}</p>
      </div>
    </div>
  </div>
</Reveal>
