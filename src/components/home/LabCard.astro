---
import { t, type Locale } from '../../i18n';
import type { ProjectEntry } from '../../lib/content';
interface Props {
  locale: Locale;
  project: ProjectEntry;
}
const { locale, project } = Astro.props;
const p = project.data;
---

<article class="fade rounded-xl border border-dashed border-line p-5">
  <h4 class="text-lg font-bold">{p.title}</h4>
  <p class="mt-1 text-sm text-sub">{p.summary}</p>
  <p class="mt-3 font-mono text-[11px] text-muted">{p.stack.join(' · ')}</p>
  <div class="mt-4 flex gap-4 text-sm font-semibold">
    {p.liveUrl && <a href={p.liveUrl} class="text-signal hover:underline" target="_blank" rel="noopener">{t(locale, 'lab.live')} ↗</a>}
    {p.repoUrl && <a href={p.repoUrl} class="text-bone hover:underline" target="_blank" rel="noopener">{t(locale, 'lab.code')} ↗</a>}
  </div>
</article>
