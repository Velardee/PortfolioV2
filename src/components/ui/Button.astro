---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  variant?: 'primary' | 'secondary';
  'data-contact-type'?: 'hire' | 'project';
};
const { variant = 'primary', class: className, ...rest } = Astro.props;
---

<a
  class:list={[
    'inline-flex items-center gap-2 rounded-lg px-5 py-3.5 text-sm font-semibold transition-transform duration-200 hover:-translate-y-0.5',
    variant === 'primary' ? 'bg-signal text-ink' : 'border border-line text-bone hover:border-bone',
    className,
  ]}
  {...rest}
><slot /></a>
