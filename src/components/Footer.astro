---
import { t, type Locale } from '../i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const updated = new Intl.DateTimeFormat(locale === 'es' ? 'es-MX' : 'en-US', { month: 'long', year: 'numeric' }).format(new Date());
---

<footer class="mx-auto max-w-[1180px] px-4 pt-10 pb-14 font-mono text-xs text-muted md:px-9">
  {t(locale, 'footer.made')} · {t(locale, 'footer.updated')} {updated}
</footer>
